<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSongItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_16sdp"
    android:layout_marginVertical="@dimen/_4sdp"
    app:cardBackgroundColor="@color/home_surface"
    app:cardCornerRadius="@dimen/_13sdp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_8sdp">

        <!-- Album artwork container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlbumArt"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_beatflow_logo"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Track Title -->
        <TextView
            android:id="@+id/tvTrackName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semi_bold"
            android:maxLines="1"
            android:textColor="@color/home_text_primary"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintBottom_toTopOf="@+id/tvArtistName"
            app:layout_constraintEnd_toStartOf="@+id/cardPlaySong"
            app:layout_constraintStart_toEndOf="@+id/cardAlbumArt"
            app:layout_constraintTop_toTopOf="@+id/cardAlbumArt"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="A Moment Apart" />

        <!-- Artist Name -->
        <TextView
            android:id="@+id/tvArtistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1"
            android:textColor="@color/home_text_secondary"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="@+id/cardAlbumArt"
            app:layout_constraintStart_toEndOf="@+id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@+id/tvTrackName"
            tools:text="ODESZA" />

        <TextView
            android:id="@+id/tvSongTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1"
            android:layout_marginStart="@dimen/_8sdp"
            android:textColor="@color/home_text_secondary"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintStart_toEndOf="@+id/tvArtistName"
            app:layout_constraintTop_toBottomOf="@+id/tvTrackName"
            tools:text="4:15" />

        <!-- Circular Play / Pause Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlaySong"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            app:cardBackgroundColor="@color/home_play_btn_bg"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnSongOverflow"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnPlaySong"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_play_song"
                android:padding="@dimen/_7sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/home_accent_cyan" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Overflow Menu Button -->
        <ImageButton
            android:id="@+id/btnSongOverflow"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_song_overflow"
            android:padding="@dimen/_5sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/home_text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
